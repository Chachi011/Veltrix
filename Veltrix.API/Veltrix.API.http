@host = http://localhost:5295

### Login as player1
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "player1@veltrix.dev", "password": "Player123!" }

### My profile (uses the token from the login above)
GET {{host}}/api/profile
Authorization: Bearer {{login.response.body.$.accessToken}}

### Refresh tokens
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login.response.body.$.refreshToken}}" }

### Game catalog (guest)
GET {{host}}/api/games

### Register a new player
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "newplayer@veltrix.dev",
  "nickname": "newplayer",
  "password": "Secret123!",
  "dateOfBirth": "2000-05-20",
  "isAdultConfirmed": true
}

### ---------- Phase 2: game ----------

### Current round of "crash" (guest)
GET {{host}}/api/games/crash/rounds/current

### Last 20 finished rounds
GET {{host}}/api/games/crash/rounds?pageSize=20

### Place a bet (only while state = BettingOpen)
# @name bet
POST {{host}}/api/bets
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "gameSlug": "crash", "amount": 10, "autoCashOutAt": 2.0 }

### Cash out (only while state = Running)
POST {{host}}/api/bets/{{bet.response.body.$.bet.id}}/cashout
Authorization: Bearer {{login.response.body.$.accessToken}}

### My wallet / ledger / daily bonus
GET {{host}}/api/wallet
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{host}}/api/wallet/transactions?pageSize=10
Authorization: Bearer {{login.response.body.$.accessToken}}

###
POST {{host}}/api/wallet/daily-bonus
Authorization: Bearer {{login.response.body.$.accessToken}}

### Provably fair check of round 1
GET {{host}}/api/fairness/rounds/1
