# VELTRIX production settings. Copy to .env on the server, fill in, then: chmod 600 .env
# .env is in .gitignore and .dockerignore: it never goes to Git or into an image. Only this template is committed.
# Generate random values on the server (docs/DEPLOY.md, step 6), e.g.:  openssl rand -base64 48

# Your domain (its DNS A record must point to the server). Caddy gets the HTTPS certificate for it.
DOMAIN=veltrix.example.com
# Let's Encrypt sends certificate warnings here
ACME_EMAIL=you@example.com

# SQL Server "sa" password: at least 8 characters with upper case, lower case and digits.
# Use letters and digits only, because it is also part of the connection string below.
SA_PASSWORD=CHANGE_ME
# Must contain the same password as SA_PASSWORD. "sqlserver" is the database container's name.
CONNECTION_STRING=Server=sqlserver;Database=Veltrix;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# Signs the login tokens: at least 32 random characters
JWT_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# The ONE admin account, created on the very first start only (later changes here are ignored).
# Password rules: at least 8 characters with an upper case letter, a lower case letter and a digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# 3-20 letters, digits or underscore (optional, default "admin")
ADMIN_NICKNAME=admin

# AI assistant via n8n (optional; leave empty to switch the assistant off)
N8N_WEBHOOK_URL=
N8N_SECRET=
