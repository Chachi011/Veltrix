# Line endings
# The repository always stores LF. These rules only decide what the working copy gets on checkout,
# so the same file looks identical on every machine and Git stops reporting line-ending-only changes.

# Default: Git detects text files and normalizes them
* text=auto

# Backend (Visual Studio convention on Windows)
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf

# Frontend (Angular tooling, Prettier and ESLint expect LF)
*.ts       text eol=lf
*.html     text eol=lf
*.scss     text eol=lf
*.json     text eol=lf

# Production server files (read on Linux, where a CRLF breaks a shell script or the Caddyfile)
*.sh          text eol=lf
*.yml         text eol=lf
Dockerfile.*  text eol=lf
Caddyfile     text eol=lf
.env.example  text eol=lf

# Binary files: never convert, never diff as text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ico      binary
*.woff2    binary
