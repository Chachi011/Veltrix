# VELTRIX behind Caddy: one site. With a domain name as the address, Caddy gets the HTTPS certificate from
# Let's Encrypt by itself, renews it, and redirects http:// to https://.
# The values come from the environment (docker-compose.prod.yml passes them from .env):
#   SITE_ADDRESS  the domain, e.g. veltrix.example.com
#   ACME_EMAIL    where Let's Encrypt sends certificate warnings
#   API_UPSTREAM  the API inside the Docker network (default api:8080)
#   WEB_ROOT      the Angular build (default /srv)
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API, the real-time hub (Caddy proxies WebSockets by itself) and the avatar files
	@api path /api/* /hubs/* /uploads/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# The Angular app: a real file if there is one, otherwise index.html (the path is a client-side route)
	handle {
		root * {$WEB_ROOT:/srv}

		# Files with a content hash in their name (main-ABCD1234.js) never change: cache them for a year.
		# Everything else, above all index.html, is checked again on every visit, so a new version shows at once.
		@hashed path_regexp -[A-Za-z0-9]{8}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path_regexp -[A-Za-z0-9]{8}\.(js|css|woff2?)$
		header @other Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
